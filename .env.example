# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model selection for Gemini analysis (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Port for Express fullstack server
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Python FastAPI NLP service URL (PyMuPDF, spaCy, sentence-transformers)
FASTAPI_NLP_URL="http://127.0.0.1:8000"

# JWT secret for authentication
JWT_SECRET="academic-research-gap-jwt-secret-key-change-in-prod"

# File storage directory outside public web root
STORAGE_DIR="./uploads"

# SQLite database file path
DATABASE_PATH="./data/research_platform.sqlite"

# Maximum upload file size in Megabytes
MAX_UPLOAD_SIZE_MB=20
